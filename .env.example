# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///./storage/migration_assistant.db
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoho_migration

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
ASYNC_MODE=in_memory

# Storage
MAX_FILE_SIZE_MB=100
