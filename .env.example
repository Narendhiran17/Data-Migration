# Zoho Data Migration Assistant - Environment Configuration Template
# Copy this file to .env and configure for your environment:
# cp .env.example .env

PROJECT_NAME="Zoho Data Migration Assistant"
VERSION=1.0.0
API_V1_STR=/api/v1

# Environment mode: development / staging / production
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# SQLite local development default:
DATABASE_URL=sqlite:///./storage/migration_assistant.db
# PostgreSQL configuration (uncomment for PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoho_migration

# Redis & Async Background Execution Mode ('in_memory' or 'celery')
REDIS_URL=redis://localhost:6379/0
ASYNC_MODE=in_memory

# Storage Directory & Upload Limits
STORAGE_DIR=./storage/uploads
MAX_FILE_SIZE_MB=100

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","tauri://localhost"]
